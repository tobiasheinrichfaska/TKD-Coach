{
  "name": "tkd-coach-workspace",
  "version": "1.0.0",
  "description": "TKD-Coach — Neuroathletik coaching app + documentation",
  "private": true,
  "workspaces": [
    "packages/native"
  ],
  "overrides": {
    "react": "19.1.0",
    "react-is": "19.1.0",
    "react-dom": "19.1.0"
  },
  "scripts": {
    "native:start": "npm run start --workspace=@tkd-coach/native",
    "native:start:tunnel": "npm run start:tunnel --workspace=@tkd-coach/native",
    "native:build": "cd packages/native && npx expo build:web",
    "native:publish": "cd packages/native && npx eas build --platform ios --profile production && npx eas build --platform android --profile production"
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  },
  "dependencies": {
    "react": "19.1.0"
  }
}
