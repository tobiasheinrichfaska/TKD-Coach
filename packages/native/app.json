{
  "expo": {
    "name": "TKD Coach",
    "slug": "tkd-coach",
    "version": "0.1.2",
    "icon": "./assets/expo/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.tobiasheinrich.tkdcoach",
      "supportsTabletMode": true,
      "supportsLandscape": true
    },
    "android": {
      "package": "com.tobiasheinrich.tkdcoach",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/expo/adaptive-icon.png",
        "backgroundColor": "#F0532C"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "TKD Coach benötigt Kamerazugriff für QR-Code Erfassung.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-audio",
      "./plugins/withTrimAudioServices",
      [
        "expo-splash-screen",
        {
          "image": "./assets/expo/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F8F8"
        }
      ]
    ],
    "orientation": "default",
    "backgroundColor": "#F8F8F8",
    "primaryColor": "#CC0000",
    "web": {
      "favicon": "./assets/expo/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a1e2b30b-1b5b-4b0b-ab44-1f98b7370f8c"
      }
    },
    "owner": "tobiasheinrich"
  }
}
