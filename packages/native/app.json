{
  "expo": {
    "name": "TKD Coach",
    "slug": "tkd-coach",
    "version": "0.1.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.tobiasheinrich.tkdcoach",
      "supportsTabletMode": true,
      "supportsLandscape": true
    },
    "android": {
      "package": "com.tobiasheinrich.tkdcoach",
      "versionCode": 1
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "TKD Coach benötigt Kamerazugriff für QR-Code Erfassung."
        }
      ],
      "expo-audio"
    ],
    "orientation": "default",
    "backgroundColor": "#F8F8F8",
    "primaryColor": "#CC0000"
  }
}
