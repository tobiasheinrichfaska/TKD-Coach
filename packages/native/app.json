{
  "expo": {
    "name": "TKD Coach",
    "slug": "tkd-coach",
    "version": "0.1.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "supportsLandscape": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.tobiasheinrich.tkdcoach"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "TKD Coach benötigt Kamerazugriff für QR-Code Erfassung."
        }
      ]
    ],
    "orientation": "portrait",
    "backgroundColor": "#F8F8F8",
    "primaryColor": "#CC0000"
  }
}
