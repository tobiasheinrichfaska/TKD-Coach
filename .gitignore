# Dependencies
node_modules/
.expo/
dist/
build/

# Expo prebuild output (managed workflow — EAS regenerates these from app.json + plugins)
packages/native/android/
packages/native/ios/

# Exception: the vendored qr-sync engine ships its compiled dist (consumed via
# file:./vendor/qr-sync so EAS cloud builds can resolve it). Must be committed.
!packages/native/vendor/qr-sync/dist/
!packages/native/vendor/qr-sync/dist/**

# OS & Editor Junk
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary Files
*.tmp
*.log
.session-*

# Backup Files
*.bak
*.backup
